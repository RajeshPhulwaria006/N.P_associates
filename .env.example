# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# MongoDB Database Connection
# In development/test, health check passes without connecting if MONGODB_URI is not set.
# Example: mongodb://localhost:27017/np_associates or MongoDB Atlas URI
MONGODB_URI=mongodb://localhost:27017/np_associates

# Session Security (Use a long random string in staging/production)
SESSION_SECRET=dev_session_secret_change_in_production_32char_min

# Business contact placeholders (verified values only; do not invent)
BUSINESS_PHONE=To be confirmed
BUSINESS_WHATSAPP=To be confirmed
